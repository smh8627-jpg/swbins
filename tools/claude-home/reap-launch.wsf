<job><script language="JScript">
// Called by reap-orphans.js with the path of reap-orphans.ps1: start it hidden through
// WMI Win32_Process.Create. A WMI-created process is born under WmiPrvSE, so it is not
// reaped along with the Claude Code hook when the hook exits. Doing the same via
// powershell took up to 7s on a busy PC (hook limit is 10s). Only a bare path is passed
// in: node escapes inner quotes as \" which WSH does not understand, so the command line
// is built here. ASCII only (WSH reads the file as ANSI).
var cmd = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + WScript.Arguments(0) + '"';
var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
var startup = wmi.Get("Win32_ProcessStartup").SpawnInstance_();
startup.ShowWindow = 0; // SW_HIDE
WScript.Quit(wmi.Get("Win32_Process").Create(cmd, null, startup, null));
</script></job>
