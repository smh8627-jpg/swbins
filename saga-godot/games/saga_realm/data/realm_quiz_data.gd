## 빠뜨린 문제는 초급으로 본다(quiz.js lvOf() 그대로) — 이 BANK는 전부
## lv가 있어 실제로는 안 걸리지만, 형식을 그대로 옮겼다.
static func lv_of(ref: Dictionary) -> int:
	var lv := int(ref.get("lv", 1))
	return lv if (lv == 2 or lv == 3) else 1


static func by_id(id: String) -> Dictionary:
	for r: Dictionary in BANK:
		if r.id == id:
			return r
	return {}
